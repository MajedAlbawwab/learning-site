---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime, slugOf } from '../lib/posts';
import type { Locale } from '../i18n';

interface Props {
  entry: CollectionEntry<'blog'>;
  lang: Locale;
  readMoreLabel: string;
  minReadLabel: string;
  basePath: string;
}

const { entry, lang, readMoreLabel, minReadLabel, basePath } = Astro.props;
const slug = slugOf(entry);
const href = `${basePath}/blog/${slug}`;
const minutes = readingTime(entry.body ?? '', lang);
---

<article class="post-card">
  <div class="post-card-meta">
    <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
    <span class="dot" aria-hidden="true">·</span>
    <span>{minutes} {minReadLabel}</span>
    {entry.data.tags.map((tag) => (
      <span class="chip">{tag}</span>
    ))}
  </div>
  <h3>
    <a href={href}>{entry.data.title}</a>
  </h3>
  <p class="post-card-desc">{entry.data.description}</p>
  <a class="read-more" href={href}>
    {readMoreLabel} <span aria-hidden="true">→</span>
  </a>
</article>

<style>
  .post-card {
    background: var(--canvas-2);
    border: 1px solid var(--stroke);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--inset-top);
  }
  .post-card:hover {
    border-color: var(--stroke-hover);
    background: var(--canvas-3);
  }
  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    margin-block-end: var(--space-sm);
  }
  .chip {
    background: var(--canvas-1);
    border: 1px solid var(--stroke);
    border-radius: var(--radius);
    padding: 2px 8px;
    color: var(--text-secondary);
  }
  .post-card h3 {
    font-size: 22px;
    line-height: 30px;
    margin-block-end: var(--space-sm);
  }
  .post-card h3 a { color: var(--text); text-decoration: none; }
  .post-card h3 a:hover { color: var(--accent); text-decoration: none; }
  .post-card-desc {
    color: var(--text-secondary);
    font-size: 15px;
    line-height: 24px;
    margin-block-end: var(--space-md);
  }
  .read-more {
    font-size: 13px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
  }
</style>
