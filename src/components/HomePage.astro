---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import { getPublishedMixed } from '../lib/posts';
import { t } from '../i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: 'en' | 'ar';
  posts: CollectionEntry<'blog'>[];
  basePath: string;
}

const { lang, posts, basePath } = Astro.props;
const d = t(lang);
const recent = getPublishedMixed(posts, lang).slice(0, 6);
---

<Base lang={lang} title={`${d.siteName} — ${d.tagline}`} description={d.tagline} current="/" canonical={`https://majed-albawwab.pages.dev${basePath === '/ar' ? '/ar/' : '/'}`}>
  <div class="container">
    <section class="hero" aria-labelledby="hero-heading">
      <h1 id="hero-heading">{d.siteName}</h1>
      <p class="hero-welcome">{d.hero.intro2}</p>
      <p class="hero-intro">{d.hero.intro1}</p>
    </section>

    <section class="latest" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">{d.blog.heading}</h2>
        <a class="all-link" href={`${basePath || ''}/blog`}>{d.blog.allPosts} →</a>
      </div>
      <div class="post-list">
        {recent.map((post) => (
          <PostRow
            entry={post}
            lang={lang}
            headingLevel={3}
            readMoreLabel={d.blog.readMore}
            minReadLabel={d.blog.minRead}
          />
        ))}
      </div>
      <div class="latest-more">
        <a class="btn-outline" href={`${basePath || ''}/blog`}>
          {d.blog.allPosts} <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
    max-inline-size: 800px;
    margin-inline: auto;
    text-align: center;
  }
  .hero h1 {
    margin-block-end: var(--space-md);
    text-wrap: balance;
  }
  .hero-intro {
    font-size: 17px;
    line-height: 1.8;
    color: var(--text-secondary);
    max-inline-size: 60ch;
    margin-inline: auto;
    text-align: center;
    text-wrap: pretty;
  }
  .hero-welcome {
    font-size: 24px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--text);
    max-inline-size: 46ch;
    margin-inline: auto;
    margin-block-end: var(--space-md);
    text-align: center;
    text-wrap: balance;
  }
  @media (max-width: 767px) {
    .hero-welcome {
      font-size: 20px;
      line-height: 28px;
    }
    .hero-intro {
      font-size: 16px;
      line-height: 1.75;
    }
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-sm);
  }
  .all-link { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; }
  .post-list {
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--stroke);
  }
  .latest-more {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-lg);
  }
  .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--text);
    background: transparent;
    border: 1px solid var(--stroke-bright);
    border-radius: var(--radius);
    padding: 10px 18px;
  }
  .btn-outline:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
  .latest { padding-block-end: var(--space-xl); }
</style>
