---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Search from '../components/Search.astro';
import { getPublished } from '../lib/posts';
import { t } from '../i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: 'en' | 'ar';
  posts: CollectionEntry<'blog'>[];
  basePath: string;
}

const { lang, posts, basePath } = Astro.props;
const d = t(lang);
const recent = getPublished(posts, lang).slice(0, 3);
---

<Base lang={lang} title={`${d.siteName} — ${d.tagline}`} description={d.tagline} current="/" canonical={`https://majed-albawwab.pages.dev${basePath === '/ar' ? '/ar/' : '/'}`}>
  <div class="container">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-status">
        <span class="status-dot" aria-hidden="true"></span>
        <span>{d.hero.status}</span>
      </div>
      <h1 id="hero-heading">{d.siteName}</h1>
      <p class="hero-tagline">{d.tagline}</p>
      <p class="hero-roles">
        <span id="typed" aria-live="polite"></span><span class="cursor" aria-hidden="true"></span>
      </p>
      <div class="hero-ctas">
        <a class="btn-primary" href={`${basePath || ''}/blog`}>{d.hero.ctaWork}</a>
        <a class="btn-secondary" href="#about">{d.hero.ctaAbout}</a>
      </div>
      <div class="hero-search">
        <Search placeholder={d.search.placeholder} label={d.search.label} basePath={basePath} />
      </div>
    </section>

    <section id="about" class="about" aria-labelledby="about-heading">
      <div class="grid">
        <div class="about-label">
          <small>01 — {d.about.heading}</small>
          <h2 id="about-heading">{d.about.heading}</h2>
        </div>
        <div class="about-body">
          <p>{d.about.body}</p>
        </div>
      </div>
    </section>

    <section class="latest" aria-labelledby="latest-heading">
      <div class="section-head">
        <h2 id="latest-heading">{d.blog.heading}</h2>
        <a class="all-link" href={`${basePath || ''}/blog`}>{d.blog.allPosts} →</a>
      </div>
      <div class="cards">
        {recent.map((post) => (
          <PostCard entry={post} lang={lang} readMoreLabel={d.blog.readMore} minReadLabel={d.blog.minRead} basePath={basePath} />
        ))}
      </div>
    </section>

    <section id="contact" class="contact" aria-labelledby="contact-heading">
      <div class="grid">
        <div class="about-label">
          <small>02 — {d.contact.heading}</small>
          <h2 id="contact-heading">{d.contact.heading}</h2>
        </div>
        <div class="about-body">
          <p>{d.contact.body}</p>
          <a class="btn-primary" href={`mailto:${d.contact.email}`}>{d.contact.emailLabel}</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script define:vars={{ roles: d.hero.roles }}>
  const el = document.getElementById('typed');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reducedMotion) {
    let ri = 0, ci = 0, deleting = false;
    const type = () => {
      const word = roles[ri];
      el.textContent = word.slice(0, ci);
      if (!deleting && ci < word.length) { ci++; setTimeout(type, 70); }
      else if (!deleting) { deleting = true; setTimeout(type, 1600); }
      else if (ci > 0) { ci--; setTimeout(type, 30); }
      else { deleting = false; ri = (ri + 1) % roles.length; setTimeout(type, 250); }
    };
    type();
  } else if (el) {
    el.textContent = roles[0];
  }
</script>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
    max-inline-size: 840px;
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--highlight);
    background: var(--surface-container);
    border: 1px solid var(--stroke);
    border-radius: var(--radius);
    padding: 4px 10px;
    margin-block-end: var(--space-md);
  }
  .status-dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--highlight);
  }
  .hero h1 { margin-block-end: var(--space-sm); }
  .hero-tagline {
    font-size: 20px;
    line-height: 30px;
    color: var(--text-secondary);
    max-inline-size: 34ch;
    margin-block-end: var(--space-sm);
  }
  .hero-roles {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 30px;
    color: var(--accent);
    margin-block-end: var(--space-lg);
    min-block-size: 30px;
  }
  .cursor {
    display: inline-block;
    inline-size: 2px;
    block-size: 1em;
    background: var(--accent);
    margin-inline-start: 2px;
    animation: blink 1s steps(1) infinite;
    vertical-align: text-bottom;
  }
  @keyframes blink { 50% { opacity: 0; } }
  .hero-ctas { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-block-end: var(--space-lg); }
  .btn-primary {
    background: var(--accent);
    color: var(--canvas);
    font-weight: 600;
    padding: 10px 18px;
    border-radius: var(--radius);
    border: 1px solid transparent;
  }
  .btn-primary:hover { background: var(--accent-hover); color: var(--canvas); text-decoration: none; }
  .btn-secondary {
    background: transparent;
    color: var(--text);
    padding: 10px 18px;
    border-radius: var(--radius);
    border: 1px solid var(--stroke);
  }
  .btn-secondary:hover { background: var(--canvas-2); border-color: var(--stroke-bright); text-decoration: none; }
  .hero-search { margin-block-end: var(--space-md); }
  .about, .contact {
    padding-block: var(--space-xl);
    border-block-start: 1px solid var(--stroke);
  }
  .about-label small { display: block; margin-block-end: var(--space-xs); }
  .about-body p { max-inline-size: 60ch; font-size: 18px; line-height: 28px; margin-block-end: var(--space-md); }
  @media (min-width: 768px) {
    .about-label { grid-column: 1 / 3; }
    .about-body { grid-column: 3 / 9; }
  }
  @media (min-width: 1024px) {
    .about-label { grid-column: 1 / 5; }
    .about-body { grid-column: 5 / 13; }
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-block-end: var(--space-md);
  }
  .all-link { font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.04em; }
  .cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gutter-mobile);
  }
  @media (min-width: 768px) { .cards { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; } }
  @media (min-width: 1024px) { .cards { grid-template-columns: repeat(3, 1fr); gap: var(--gutter); } }
  .latest { padding-block-end: var(--space-xl); }
</style>
