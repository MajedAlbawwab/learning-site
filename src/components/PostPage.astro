---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, readingTime, slugOf, findTranslation } from '../lib/posts';
import { t, loc } from '../i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: 'en' | 'ar';
  slug: string;
  basePath: string;
}

const { lang, slug, basePath } = Astro.props;
const d = t(lang);
const all: CollectionEntry<'blog'>[] = await getCollection('blog');
const entry = all.find((e) => slugOf(e) === slug && e.data.publish && !e.data.draft && e.data.lang === lang);
if (!entry) throw new Error(`Post not found: ${slug}/${lang}`);

const { Content } = await render(entry);
const minutes = readingTime(entry.body ?? '', lang);
const translation = findTranslation(entry, all);
const otherLang: 'ar' | 'en' = lang === 'ar' ? 'en' : 'ar';
const otherBase = otherLang === 'ar' ? '/ar' : '';
const altHref = translation
  ? `${otherBase}/blog/${slugOf(translation)}`
  : `${otherBase}/blog`;

const canonical = `https://majed-albawwab.pages.dev${basePath}/blog/${slug}`;
const altCanonical = `https://majed-albawwab.pages.dev${otherBase}/blog/${translation ? slugOf(translation) : ''}`;
const hreflangEn = lang === 'en' ? canonical : altCanonical;
const hreflangAr = lang === 'ar' ? canonical : altCanonical;
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  current="/blog"
  altHref={altHref}
  canonical={canonical}
  hreflangEn={hreflangEn}
  hreflangAr={hreflangAr}
>
  <article class="container post-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href={loc('/', lang)}>{d.nav.home}</a>
      <span aria-hidden="true">/</span>
      <a href={loc('/blog', lang)}>{d.nav.blog}</a>
    </nav>

    <header class="post-header">
      <div class="post-meta">
        <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes} {d.blog.minRead}</span>
        {entry.data.updated && (
          <>
            <span aria-hidden="true">·</span>
            <span>{d.post.updated} {formatDate(entry.data.updated, lang)}</span>
          </>
        )}
      </div>
      <h1>{entry.data.title}</h1>
      <p class="post-desc">{entry.data.description}</p>
      {entry.data.tags.length > 0 && (
        <div class="post-tags" aria-label={d.post.tags}>
          {entry.data.tags.map((tag) => <span class="chip">{tag}</span>)}
        </div>
      )}
    </header>

    <div class="prose post-body">
      <Content />
    </div>

    <div class="translation-note">
      <a href={altHref}>{translation ? (otherLang === 'ar' ? 'اقرأ بالعربية' : 'Read in English') : `${d.blog.heading} →`}</a>
    </div>
  </article>
</Base>

<script define:vars={{ copyLabel: d.post.copy, copiedLabel: d.post.copied }}>
  document.querySelectorAll('.post-body pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-btn';
    button.textContent = copyLabel;
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.innerText ?? pre.innerText;
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = copiedLabel;
        setTimeout(() => (button.textContent = copyLabel), 1600);
      } catch {}
    });
    pre.parentElement?.insertBefore(button, pre);
    pre.style.position = 'relative';
  });
</script>

<style>
  .post-page { padding-block: var(--space-xl); max-inline-size: 840px; }
  .breadcrumb {
    display: flex;
    gap: var(--space-sm);
    font-size: 12px;
    font-family: var(--font-mono);
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin-block-end: var(--space-lg);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    margin-block-end: var(--space-sm);
  }
  .post-header h1 { margin-block-end: var(--space-sm); }
  .post-desc {
    font-size: 18px;
    line-height: 28px;
    color: var(--text-secondary);
    max-inline-size: 60ch;
    margin-block-end: var(--space-md);
  }
  .post-tags { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-block-end: var(--space-xl); }
  .chip {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    background: var(--canvas-1);
    border: 1px solid var(--stroke);
    border-radius: var(--radius);
    padding: 4px 10px;
    color: var(--text-secondary);
  }
  .post-body { margin-block-end: var(--space-xl); }
  .post-body :global(blockquote) {
    background: var(--surface-container);
    border: 1px solid var(--stroke);
    border-radius: var(--radius-lg);
    padding: var(--space-md);
  }
  .post-body :global(.copy-btn) {
    position: absolute;
    inset-inline-end: var(--space-sm);
    inset-block-start: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    background: var(--canvas-1);
    border: 1px solid var(--stroke);
    border-radius: var(--radius);
    padding: 4px 10px;
    color: var(--text-secondary);
    cursor: pointer;
  }
  .post-body :global(.copy-btn:hover) { color: var(--text); border-color: var(--stroke-hover); }
  .translation-note {
    border-block-start: 1px solid var(--stroke);
    padding-block-start: var(--space-md);
  }
</style>
